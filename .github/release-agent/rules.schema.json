{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattermost/mattermost/.github/release-agent/rules.schema.json",
  "title": "Release agent rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "calendar", "naming", "false_alarm_emoji", "rules"],
  "properties": {
    "version": {"const": 1},
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestones", "active_days_after_release"],
      "properties": {
        "milestones": {
          "description": "Milestone key to the substring that identifies its calendar event title.",
          "type": "object",
          "required": ["branch_cut", "release_day"],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "holiday_markers": {
          "description": "Substrings that mark a calendar event as a non-working day.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "active_days_after_release": {"type": "integer", "minimum": 0}
      }
    },
    "holidays": {
      "description": "Extra non-working days, as YYYY-MM-DD.",
      "type": "array",
      "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "holidays_page_heading": {
      "description": "Heading of each year's list on the Confluence holidays page, with {year}.",
      "type": "string",
      "pattern": "\\{year\\}"
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone", "fix_version", "release_channels"],
      "properties": {
        "milestone": {"type": "string", "minLength": 1},
        "fix_version": {"type": "string", "minLength": 1},
        "release_channels": {
          "description": "Display names a release's channel can have, such as the ESR one.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "false_alarm_emoji": {"type": "string", "pattern": "^[a-z0-9_+-]+$"},
    "channels": {
      "description": "Hub channels asks go to: a key to a channel ID, or \"{release_channel}\" for the release's own.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^([a-z0-9]{26}|\\{release_channel\\})$"}
    },
    "ask_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changelog_url", "rc_build_url", "healthcheck_repo", "mobile_repo", "desktop_repo", "loadtest_epic_jql", "contributors_org"],
      "properties": {
        "changelog_url": {"type": "string", "pattern": "^https://"},
        "rc_build_url": {"type": "string", "pattern": "^https://"},
        "healthcheck_repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
        "mobile_repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
        "desktop_repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
        "loadtest_epic_jql": {"type": "string", "minLength": 1},
        "contributors_org": {"type": "string", "pattern": "^[\\w.-]+$"}
      }
    },
    "support_packet_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "manual_test_guidelines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "version", "title", "url"],
      "properties": {
        "page_id": {"type": "string", "pattern": "^\\d+$"},
        "version": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "manual_test_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo", "paths", "what", "tests"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repo": {"enum": ["mobile", "desktop"]},
          "paths": {"description": "Files, directories ending in /, or globs.", "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "what": {"description": "What the tester does, from the guidelines.", "type": "string", "minLength": 1},
          "tests": {"description": "The test IDs, from the guidelines.", "type": "string", "minLength": 1}
        }
      }
    },
    "contributor_bot_logins": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "if": {"properties": {"type": {"const": "ask"}}, "required": ["type"]},
        "then": {"$ref": "#/$defs/ask"},
        "else": {"$ref": "#/$defs/rule"}
      }
    }
  },
  "$defs": {
    "ask": {
      "description": "An ask to another team: sent on its due day, followed up, and its playbook item ticked when done (release_agent/asks.py).",
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "title", "playbook_item", "due", "type", "needed_when", "send", "done_when", "remind_after"],
      "properties": {
        "task": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "title": {"description": "What the status post's Handoffs section calls the ask.", "type": "string", "minLength": 1},
        "playbook_item": {
          "description": "The checklist item ticked when the ask is done or not needed. A title ending in … matches items that start with it; a … inside the title matches any text, so a person named in the title can be left out.",
          "type": "string",
          "minLength": 1
        },
        "former_playbook_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "due": {
          "description": "As a check's due, or first_working_day_of_month for the monthly contributors ask.",
          "type": "string",
          "pattern": "^(T[-+]\\d+|[a-z][a-z0-9_]*([-+]\\d+)?)$"
        },
        "avoid_friday": {"description": "When due falls on a Friday, send on the next working day.", "type": "boolean"},
        "type": {"const": "ask"},
        "needed_when": {"enum": ["always", "rc1_tagged", "rc1_announced", "final_build_tagged", "support_packet_changed", "manual_test_areas_changed", "monthly"]},
        "send": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "to", "template"],
          "properties": {
            "channel": {"description": "A key of channels.", "type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "to": {"description": "Roles in RELEASE_AGENT_PEOPLE.", "type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
            "template": {"description": "A file in templates/, or contributors.", "type": "string", "pattern": "^([a-z0-9-]+\\.md|contributors)$"},
            "reminder": {"description": "A file in templates/; reminder.md when not set.", "type": "string", "pattern": "^[a-z0-9-]+\\.md$"},
            "reply_to": {"description": "The ask (task) whose thread this one replies in.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
          }
        },
        "done_when": {"enum": ["sent", "ces_issue", "docs_labels", "qa_reply", "sre_reply"]},
        "done_before_ask": {"description": "False to send the ask even when its done check already passes.", "type": "boolean"},
        "rings": {"description": "For sre_reply: the Cloud rings that must be done.", "type": "array", "minItems": 1, "items": {"enum": ["beta", "freemium", "professional", "enterprise"]}},
        "remind_after": {"description": "Working days with no answer before one reminder; 0 for none.", "type": "integer", "minimum": 0},
        "remind_every": {"description": "After the first reminder, another every this many working days.", "type": "integer", "minimum": 1},
        "escalate_at": {"type": "string", "pattern": "^(T[-+]\\d+|[a-z][a-z0-9_]*([-+]\\d+)?)$"},
        "escalate_after": {"description": "Overdue this many working days after the ask was sent.", "type": "integer", "minimum": 1}
      },
      "allOf": [{"if": {"properties": {"done_when": {"const": "sre_reply"}}}, "then": {"required": ["rings"]}}]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "title", "playbook_item", "due", "type", "source", "query", "pass_when", "on_fail"],
      "properties": {
        "task": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "title": {"description": "What the status post calls the check.", "type": "string", "minLength": 1},
        "playbook_item": {
          "description": "The checklist item title in the Cloud & Self-Hosted playbook as it reads on screen, or null to tick nothing. A title ending in … matches items that start with it; a … inside the title matches any text, so a person named in the title can be left out.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "former_playbook_items": {
          "description": "Earlier titles of playbook_item, still on runs started before it was renamed.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "due": {
          "description": "T-N / T+N in working days from Release Day, or a calendar milestone key with an optional working-day offset.",
          "type": "string",
          "pattern": "^(T[-+]\\d+|[a-z][a-z0-9_]*([-+]\\d+)?)$"
        },
        "type": {
          "enum": [
            "open_release_items",
            "cherry_picks_to_label",
            "new_regressions",
            "resolved_tickets",
            "changelog_pr",
            "changelog_migrations",
            "hub_release_branch",
            "notice_txt",
            "cherry_picks",
            "e2e_results",
            "release_tags",
            "version_go_prs",
            "changelog_labels",
            "holidays_page",
            "loadtest_results"
          ]
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["jira", "github", "hub", "confluence", "docs"]}
        },
        "query": {
          "type": "object",
          "properties": {
            "migrations_path": {"description": "Folder of PostgreSQL migrations, e.g. server/channels/db/migrations/postgres.", "type": "string", "minLength": 1},
            "dev_leads": {
              "description": "How unassigned and bot tickets find their dev lead: which Jira field names the team. The routes themselves are the repository variable RELEASE_AGENT_DEV_LEADS, not part of this file.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "match_field": {"enum": ["team", "components"]},
                "team_field": {"description": "The Jira Team field, e.g. customfield_10800.", "type": "string", "pattern": "^customfield_\\d+$"}
              },
              "if": {"properties": {"match_field": {"const": "team"}}, "required": ["match_field"]},
              "then": {"required": ["team_field"]}
            }
          }
        },
        "pass_when": {
          "enum": [
            "report_only",
            "all_have_fix_version",
            "versions_match",
            "merged_and_on_release_branch",
            "all_on_release_branch",
            "found",
            "present",
            "merged",
            "none_missing",
            "state_reached",
            "described_or_none",
            "next_year_listed",
            "epic_closed_and_results_posted"
          ]
        },
        "on_fail": {"enum": ["needs_attention", "log_only", "report"]}
      },
      "allOf": [
        {
          "if": {"properties": {"pass_when": {"const": "report_only"}}},
          "then": {"properties": {"on_fail": {"const": "report"}}}
        }
      ]
    }
  }
}

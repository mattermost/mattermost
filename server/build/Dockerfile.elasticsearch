ARG ELASTICSEARCH_VERSION=9.0.0
FROM docker.elastic.co/elasticsearch/elasticsearch:${ELASTICSEARCH_VERSION}

ARG INSTALL_ANALYSIS_ICU=true

RUN plugins="analysis-nori analysis-kuromoji analysis-smartcn"; \
    if [ "$INSTALL_ANALYSIS_ICU" = "true" ]; then plugins="analysis-icu $plugins"; fi; \
    /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch $plugins

ARG OPENSEARCH_VERSION=3.0.0
FROM opensearchproject/opensearch:$OPENSEARCH_VERSION

ARG INSTALL_ANALYSIS_ICU=true

RUN plugins="analysis-nori analysis-kuromoji analysis-smartcn"; \
    if [ "$INSTALL_ANALYSIS_ICU" = "true" ]; then plugins="analysis-icu $plugins"; fi; \
    /usr/share/opensearch/bin/opensearch-plugin install $plugins

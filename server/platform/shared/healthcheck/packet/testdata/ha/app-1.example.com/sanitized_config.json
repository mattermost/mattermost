{
    "ServiceSettings": {
        "SiteURL": "http://app-1.internal.example.com",
        "WebsocketURL": "",
        "ListenAddress": ":8065",
        "ConnectionSecurity": "",
        "TLSMinVer": "1.2",
        "Forward80To443": false,
        "EnableIncomingWebhooks": true,
        "EnableOutgoingWebhooks": true
    },
    "SqlSettings": {
        "DriverName": "postgres",
        "DataSource": "postgres://****:****@db.example.com:5432/mattermost?connect_timeout=10\u0026sslmode=require",
        "DataSourceReplicas": [],
        "DataSourceSearchReplicas": [],
        "MaxIdleConns": 10,
        "MaxOpenConns": 100
    },
    "LogSettings": {
        "EnableConsole": true,
        "ConsoleLevel": "INFO",
        "ConsoleJson": true,
        "EnableFile": true,
        "FileLevel": "INFO",
        "FileJson": true,
        "FileLocation": ""
    },
    "FileSettings": {
        "DriverName": "local",
        "Directory": "/mnt/mattermost/data/",
        "AmazonS3Bucket": "",
        "AmazonS3SSL": true
    },
    "EmailSettings": {
        "SendEmailNotifications": true,
        "SMTPServer": "smtp.example.com",
        "SMTPPort": "587",
        "SMTPPassword": "********************************",
        "SendPushNotifications": true,
        "PushNotificationServer": "http://push.example.com",
        "PushNotificationContents": "full"
    },
    "ClusterSettings": {
        "Enable": true,
        "ClusterName": "production",
        "OverrideHostname": "",
        "NetworkInterface": "",
        "BindAddress": "",
        "AdvertiseAddress": "",
        "UseIPAddress": true,
        "EnableGossipCompression": true,
        "EnableGossipEncryption": true,
        "ReadOnlyConfig": true,
        "GossipPort": 8074
    },
    "CacheSettings": {
        "CacheType": "lru",
        "RedisAddress": "",
        "RedisPassword": "",
        "RedisDB": -1
    },
    "RateLimitSettings": {
        "Enable": false,
        "PerSec": 10,
        "MaxBurst": 100,
        "MemoryStoreSize": 10000,
        "VaryByRemoteAddr": true,
        "VaryByUser": false,
        "VaryByHeader": ""
    },
    "MetricsSettings": {
        "Enable": true,
        "ListenAddress": ":8067"
    },
    "PluginSettings": {
        "Enable": true,
        "EnableUploads": false,
        "EnableHealthCheck": true,
        "PluginStates": {
            "com.github.manland.mattermost-plugin-gitlab": {
                "Enable": false
            },
            "com.mattermost.calls": {
                "Enable": true
            }
        }
    },
    "FeatureFlags": {
        "TestFeature": "off",
        "HealthDashboard": false
    }
}
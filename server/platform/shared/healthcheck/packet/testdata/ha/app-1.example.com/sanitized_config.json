{
    "ServiceSettings": {
        "SiteURL": "http://app-1.internal.example.com",
        "WebsocketURL": "",
        "ListenAddress": ":8065",
        "ConnectionSecurity": "",
        "TLSMinVer": "1.2",
        "Forward80To443": false,
        "EnableIncomingWebhooks": true,
        "EnableOutgoingWebhooks": true,
        "ExtendSessionLengthWithActivity": true
    },
    "SqlSettings": {
        "DriverName": "postgres",
        "DataSource": "postgres://****:****@db.example.com:5432/mattermost?connect_timeout=10\u0026sslmode=require",
        "DataSourceReplicas": [],
        "DataSourceSearchReplicas": [],
        "MaxIdleConns": 10,
        "MaxOpenConns": 100
    },
    "EmailSettings": {
        "SendEmailNotifications": true,
        "SMTPServer": "smtp.example.com",
        "SMTPPort": "587",
        "SMTPPassword": "********************************",
        "SendPushNotifications": true,
        "PushNotificationServer": "http://push.example.com",
        "PushNotificationContents": "full"
    },
    "LdapSettings": {
        "Enable": false,
        "EnableSync": true,
        "LdapServer": "dc1.example.com",
        "LdapPort": 636,
        "ConnectionSecurity": "TLS",
        "BaseDN": "dc=example,dc=com",
        "IdAttribute": "objectGUID",
        "SyncIntervalMinutes": 60,
        "SkipCertificateVerification": false,
        "QueryTimeout": 60
    },
    "SamlSettings": {
        "Enable": true,
        "Verify": true,
        "Encrypt": false,
        "IdpURL": "https://adfs.example.com/adfs/ls/",
        "IdpDescriptorURL": "https://adfs.example.com/adfs/services/trust",
        "IdpMetadataURL": "https://adfs.example.com/FederationMetadata/2007-06/FederationMetadata.xml",
        "SignatureAlgorithm": "RSAwithSHA256",
        "IdAttribute": "objectGUID"
    },
    "ClusterSettings": {
        "Enable": true,
        "ClusterName": "production",
        "OverrideHostname": "",
        "NetworkInterface": "",
        "BindAddress": "",
        "AdvertiseAddress": "",
        "UseIPAddress": true,
        "EnableGossipCompression": true,
        "ReadOnlyConfig": true,
        "GossipPort": 8074
    },
    "FeatureFlags": {
        "TestFeature": "off",
        "HealthDashboard": false
    }

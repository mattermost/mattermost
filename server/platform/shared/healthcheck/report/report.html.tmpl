<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
body { margin: 0 auto; max-width: 960px; padding: 32px 24px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 14px; line-height: 1.5; color: #1f2329; background: #fff; }
h1 { font-size: 24px; margin: 0 0 16px; }
h2 { font-size: 18px; margin: 32px 0 12px; padding-bottom: 4px; border-bottom: 1px solid #dde0e4; }
h3 { font-size: 15px; margin: 0 0 4px; }
p { margin: 4px 0; }
dl.header { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 16px; }
dl.header dt { font-weight: 600; }
dl.header dd { margin: 0; }
.note { margin: 0 0 16px; padding: 8px 12px; border-left: 4px solid #8a95a3; background: #f4f5f6; }
.stale { color: #b42318; font-weight: 600; }
.finding { margin: 0 0 12px; padding: 12px 16px; border: 1px solid #dde0e4; border-left-width: 4px; border-radius: 4px; break-inside: avoid; }
.critical .finding { border-left-color: #d24b4e; }
.warning .finding { border-left-color: #ffbc1f; }
.info .finding { border-left-color: #5d89ea; }
.tag { display: inline-block; margin-right: 6px; padding: 0 6px; border-radius: 4px; background: #eceef0; font-size: 12px; font-weight: 600; vertical-align: 1px; }
.label { font-weight: 600; }
.code { font-size: 12px; font-weight: normal; color: #5d6670; }
details { margin-top: 8px; }
summary { cursor: pointer; font-weight: 600; }
details dl { display: grid; grid-template-columns: max-content 1fr; gap: 2px 16px; margin: 4px 0 0; }
details dd { margin: 0; overflow-wrap: anywhere; }
ul.findings { margin: 0; padding-left: 20px; }
ul.findings li { margin: 4px 0; }
a { color: #1c58d9; }
@media print {
  body { max-width: none; padding: 0; font-size: 11pt; }
  h2 { break-after: avoid; }
  a { color: inherit; }
  summary { list-style: none; }
  details::details-content { content-visibility: visible; display: block; }
}
</style>
</head>
<body>
<h1>{{.Title}}</h1>
{{range .Notes}}<p class="note">{{.}}</p>
{{end -}}
<dl class="header">
{{range .Header}}<dt>{{.Label}}</dt><dd>{{.Value}}</dd>
{{end -}}
</dl>
{{with .Stale}}<p class="stale">{{.}}</p>
{{end -}}
<h2>{{.Labels.Summary}}</h2>
<p>{{.Summary}}</p>
{{with .AlsoIncluded}}<p>{{.}}</p>
{{end -}}
{{range .Sections}}
<section class="{{.Kind}}">
<h2>{{.Title}}</h2>
{{- if eq .Kind "unknown"}}
<ul class="findings">
{{range .Findings}}<li><span class="label">{{.Title}}</span>{{template "code" .}}: {{.Message}}</li>
{{end -}}
</ul>
{{- else if eq .Kind "muted"}}
<ul class="findings">
{{range .Findings}}<li><span class="label">{{.Title}}</span>{{template "code" .}} <span class="tag">{{.Severity}}</span>{{with .Message}} {{.}}{{end}}</li>
{{end -}}
</ul>
{{- else if eq .Kind "resolved"}}
<ul class="findings">
{{range .Findings}}<li>{{.Title}}{{template "code" .}}</li>
{{end -}}
</ul>
{{- else}}
{{- range .Findings}}
<div class="finding">
<h3><span class="tag">{{.Area}}</span>{{.Title}}{{template "code" .}}</h3>
{{with .Message}}<p>{{.}}</p>
{{end -}}
{{with .Remediation}}<p><span class="label">{{$.Labels.Remediation}}:</span> {{.}}</p>
{{end -}}
{{with .ConsoleURL}}<p><a href="{{.}}">{{$.Labels.Console}}</a></p>
{{end -}}
{{with .DocsURL}}<p><a href="{{.}}">{{$.Labels.Documentation}}</a></p>
{{end -}}
{{with .Details}}<details>
<summary>{{$.Labels.Details}}</summary>
<dl>
{{range .}}<dt><code>{{.Label}}</code></dt><dd>{{.Value}}</dd>
{{end -}}
</dl>
</details>
{{end -}}
</div>
{{- end}}
{{- end}}
</section>
{{- end}}
</body>
</html>
{{- define "code"}}{{with .Code}} <code class="code">{{.}}</code>{{end}}{{end}}

{
    "admin_sidebar_plugin_category": {
        "template": "admin.sidebar.category.plugin:{key}--listitem"
    },
    "app_bar_button": {
        "template": "app_bar.plugin:{key}--button",
        "registry": ["registerAppBarComponent", "registerChannelHeaderButtonAction"]
    },
    "channel_header_bookmarks_menu_item": {
        "template": "channel_header.menu.bookmarks.plugin:{key}--menuitem",
        "registry": ["registerChannelBookmarksMenuAction"]
    },
    "channel_header_dropdown_item": {
        "template": "channel_header.plugin_actions.menu.action:{key}--link",
        "registry": ["registerChannelHeaderButtonAction"]
    },
    "channel_header_menu_item": {
        "template": "channel_header.menu.plugin:{key}--menuitem",
        "registry": ["registerChannelHeaderMenuAction"]
    },
    "file_menu_item": {
        "template": "*.file_card.menu.plugin:{key}--menuitem",
        "registry": ["registerFileDropdownMenuAction"]
    },
    "file_upload_method": {
        "template": "*.attach_menu.plugin:{key}--menuitem",
        "registry": ["registerFileUploadMethod"]
    },
    "lhs_browse_or_add_menu_item": {
        "template": "lhs.browse_or_add_menu.plugin:{key}--menuitem",
        "registry": ["registerSidebarBrowseOrAddChannelMenuAction"]
    },
    "lhs_team_menu_item": {
        "template": "lhs.team_menu.plugin:{key}--menuitem",
        "registry": ["registerMainMenuAction"]
    },
    "marketplace_plugin_item": {
        "template": "marketplace_modal.plugin:{key}--region"
    },
    "post_menu_item": {
        "template": "*.actions_menu.plugin:{key}--menuitem",
        "registry": ["registerPostDropdownMenuAction"]
    },
    "rhs_panel": {
        "template": "rhs.plugin:{key}--region",
        "registry": ["registerRightHandSidebarComponent"]
    },
    "search_file_menu_item": {
        "template": "search.results.file.menu.plugin:{key}--menuitem",
        "registry": ["registerFileDropdownMenuAction"]
    }
}

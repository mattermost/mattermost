            "type": "array",
            "items": {
                "$ref": "common.schema.json#/definitions/oracleClass"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "leakage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rules", "exempt_paths"],
            "properties": {
                "rules": {
                    "type": "array",
                    "minItems": 5,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "kind"],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^L[0-9]{1,2}$"
                            },
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "ordered_phrase",
                                    "numbered_steps",
                                    "deny_labels",
                                    "unknown_key",
                                    "forbidden_key"
                                ]
                            },
                            "patterns": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                },
                                "maxItems": 20
                            },
                            "deny_list": {
                                "$ref": "common.schema.json#/definitions/repoPath"
                            }
                        },
                        "allOf": [
                            {
                                "if": {
                                    "properties": {
                                        "kind": {
                                            "const": "ordered_phrase"
                                        }
                                    },
                                    "required": ["kind"]
                                },
                                "else": {
                                    "properties": {
                                        "patterns": false
                                    }
                                }
                            },
                            {
                                "if": {
                                    "properties": {
                                        "kind": {
                                            "const": "deny_labels"
                                        }
                                    },
                                    "required": ["kind"]
                                },
                                "then": {
                                    "required": ["deny_list"]
                                },
                                "else": {
                                    "properties": {
                                        "deny_list": false
                                    }
                                }
                            }
                        ]
                    },
                    "allOf": [
                        {
                            "contains": {
                                "properties": {
                                    "kind": {
                                        "const": "ordered_phrase"
                                    }
                                },
                                "required": ["kind"]
                            }
                        },
                        {
                            "contains": {
                                "properties": {
                                    "kind": {
                                        "const": "numbered_steps"
                                    }
                                },
                                "required": ["kind"]
                            }
                        },
                        {
                            "contains": {
                                "properties": {
                                    "kind": {
                                        "const": "deny_labels"
                                    }
                                },
                                "required": ["kind"]
                            }
                        },
                        {
                            "contains": {
                                "properties": {
                                    "kind": {
                                        "const": "unknown_key"
                                    }
                                },
                                "required": ["kind"]
                            }
                        },
                        {
                            "contains": {
                                "properties": {
                                    "kind": {
                                        "const": "forbidden_key"
                                    }
                                },
                                "required": ["kind"]
                            }
                        }
                    ]
                },
                "exempt_paths": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "fixture",
                            "fixture_setup",
                            "negative_controls",
                            "target_release",
                            "dedupe",
                            "qualifies_reason",
                            "**.source",
                            "**.why",
                            "**.note"
                        ]
                    },
                    "uniqueItems": true
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "schema": {
                        "const": "explorer-charter/v2"
                    }
                },
                "required": ["schema"]
            },
            "then": {
                "required": ["charter_id", "goal", "lane", "start", "budget", "action_rules", "leakage"],
                "properties": {
                    "allowed_actions": false,
                    "journey_id": false
                }
            }
        },
        {
            "if": {
                "properties": {
                    "schema": {
                        "const": "explorer-session-charter/v1"
                    }
                },
                "required": ["schema"]
            },
            "then": {
                "required": [
                    "feature_id",
                    "lane",
                    "charter",
                    "start",
                    "allowed_actions",
                    "budget",
                    "expected_outcome",
                    "dedupe"
                ],
                "properties": {
                    "journey_id": false,
                    "charter_id": false,
                    "leakage": false
                }
            }
        },
        {
            "if": {
                "properties": {
                    "schema": {
                        "const": "explorer-journey-charter/v1"
                    }
                },
                "required": ["schema"]
            },
            "then": {
                "required": [
                    "journey_id",
                    "feature_id",
                    "lane",
                    "goal",
                    "actors",
                    "start",
                    "action_rules",
                    "checkpoints",
                    "success_criteria",
                    "budget",
                    "dedupe"
                ],
                "properties": {
                    "charter_id": false,
                    "leakage": false,
                    "allowed_actions": false
                }
            }
        }
    ]

                },
                "ordering": {
                    "type": "string",
                    "maxLength": 1500
                },
                "path_conditions": {
                    "type": "string",
                    "maxLength": 1500
                },
                "selection": {
                    "type": "string",
                    "maxLength": 1500
                }
            }
        },
        "negative_controls": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id"],
                "propertyNames": {
                    "not": {
                        "pattern": "(?:(?:(?<![A-Za-z])[sS]|(?<=[a-z])S)[tT][eE][pP][sS]?(?![a-z])|(?:(?<![A-Za-z])[rR]|(?<=[a-z])R)[oO][uU][tT][eE][sS]?(?![a-z])|(?:(?<![A-Za-z])[sS]|(?<=[a-z])S)[eE][qQ][uU][eE][nN][cC][eE][sS]?(?![a-z])|(?:(?<![A-Za-z])[wW]|(?<=[a-z])W)[aA][lL][kK][tT][hH][rR][oO][uU][gG][hH][sS]?(?![a-z])|(?:(?<![A-Za-z])[sS]|(?<=[a-z])S)[cC][rR][iI][pP][tT][sS]?(?![a-z])|(?:(?<![A-Za-z])[pP]|(?<=[a-z])P)[rR][oO][cC][eE][dD][uU][rR][eE][sS]?(?![a-z])|(?:(?<![A-Za-z])[rR]|(?<=[a-z])R)[eE][cC][iI][pP][eE][sS]?(?![a-z])|(?:(?<![A-Za-z])[pP]|(?<=[a-z])P)[lL][aA][yY][bB][oO][oO][kK][sS]?(?![a-z])|(?:(?<![A-Za-z])[iI]|(?<=[a-z])I)[tT][iI][nN][eE][rR][aA][rR][yY][sS]?(?![a-z])|(?:(?<![A-Za-z])[wW]|(?<=[a-z])W)[aA][yY][pP][oO][iI][nN][tT][sS]?(?![a-z])|(?:(?<![A-Za-z])[bB]|(?<=[a-z])B)[rR][eE][aA][dD][cC][rR][uU][mM][bB][sS]?(?![a-z])|(?:(?<![A-Za-z])[rR]|(?<=[a-z])R)[eE][aA][cC][hH][aA][bB][lL][eE][sS]?(?![a-z])|(?:(?<![A-Za-z])[cC]|(?<=[a-z])C)[lL][iI][cC][kK][sS]?(?![a-z])|(?:(?<![A-Za-z])[nN]|(?<=[a-z])N)[aA][vV][iI][gG][aA][tT][eE][sS]?(?![a-z]))"
                    }

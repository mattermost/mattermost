{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://explorer-proto.invalid/v2/schemas/common.schema.json",
    "title": "Shared definitions for the explorer v2 artifact schemas",
    "definitions": {
        "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "imageDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "imageRef": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
            "maxLength": 200
        },
        "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "featureId": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
        },
        "semver": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "count": {
            "type": "integer",
            "minimum": 0
        },
        "seconds": {
            "type": "number",
            "minimum": 0
        },
        "line": {
            "type": "integer",
            "minimum": 1
        },
        "repoPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.@+/-]+$",
            "maxLength": 240
        },
        "sourceRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line"],
            "properties": {
                "file": {
                    "$ref": "#/definitions/repoPath"
                },
                "line": {
                    "$ref": "#/definitions/line"
                }
            }
        },
        "sanitizedPath": {
            "description": "URL path only: no origin, query, fragment, port or 26-character server id. Use <placeholder> segments.",
            "type": "string",
            "maxLength": 200,
            "allOf": [
                {
                    "pattern": "^/[A-Za-z0-9_<>.-]*(?:/[A-Za-z0-9_<>.-]*)*$"
                },
                {
                    "not": {
                        "pattern": "(?:^|/)[a-z0-9]{26}(?:/|$)"
                    }
                },
                {
                    "not": {
                        "pattern": "\\.\\."
                    }
                }
            ]
        },
        "shortText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
        },
        "evidenceText": {
            "description": "Sanitized observation text. Must not contain an origin, loopback host, session material or a server id.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "not": {
                "pattern": "(?:https?://|\\b127\\.0\\.0\\.1\\b|\\blocalhost\\b|MMAUTHTOKEN|MMCSRF|\\bBearer\\s|\\bpassword\\s*[:=]|\\b(?=[a-z0-9]*[0-9])[a-z0-9]{26}\\b)"
            }
        },
        "role": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "maxLength": 40
        },
        "accessibleName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
        },
        "control": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name"],
            "properties": {
                "role": {
                    "$ref": "#/definitions/role"
                },
                "name": {
                    "$ref": "#/definitions/accessibleName"
                }
            }
        },
        "oracleClass": {
            "type": "string",
            "enum": [
                "console_error",
                "uncaught_exception",
                "failed_request",
                "http_server_error",
                "dead_control",
                "stale_content",
                "state_not_persisted",
                "typed_input_ignored",
                "keyboard_unreachable",
                "focus_lost",
                "accessible_name_missing",
                "layout_overflow",
                "unexpected_dialog",
                "unexpected_reload"
            ]
        },
        "outcome": {
            "type": "string",
            "enum": ["emitted_passing", "rejected_duplicate", "rejected_unreachable", "failed", "blocked"]
        },
        "gateName": {
            "type": "string",
            "enum": [
                "schema",
                "guard",
                "licence",
                "duplicate",
                "leakage",
                "discovery",
                "emit",
                "lint",
                "stability",
                "control_sensitivity",
                "secret_scan"
            ]
        },
        "triState": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
        },
        "evidenceRef": {
            "description": "Pointer to an artifact. The ref is an identifier or repo path with an optional :line or #anchor, never prose.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": ["trace", "finding", "verdict", "spec", "report", "log", "snapshot", "source", "manual"]
                },
                "ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.@+/#:=-]{1,240}$"
                }
            }
        },
        "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/evidenceRef"
            }
        },
        "reviewerHandle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,38}$"
        }
    }
}

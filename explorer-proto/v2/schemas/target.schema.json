{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://explorer-proto.invalid/v2/schemas/target.schema.json",
    "title": "Explorer v2 target: the exact product build under test",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "kind",
        "ref",
        "sha",
        "image",
        "server_version",
        "licence_check",
        "playwright_version",
        "browser_build"
    ],
    "properties": {
        "schema": {
            "const": "explorer-target/v2"
        },
        "kind": {
            "type": "string",
            "enum": ["release", "main"]
        },
        "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,100}$"
        },
        "sha": {
            "$ref": "common.schema.json#/definitions/sha1"
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "digest", "platform"],
            "properties": {
                "ref": {
                    "$ref": "common.schema.json#/definitions/imageRef"
                },
                "digest": {
                    "$ref": "common.schema.json#/definitions/imageDigest"
                },
                "platform": {
                    "const": "linux/amd64"
                },
                "build_sha": {
                    "$ref": "common.schema.json#/definitions/sha1"
                }
            }
        },
        "database_image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "digest"],
            "properties": {
                "ref": {
                    "$ref": "common.schema.json#/definitions/imageRef"
                },
                "digest": {
                    "$ref": "common.schema.json#/definitions/imageDigest"
                }
            }
        },
        "server_version": {
            "$ref": "common.schema.json#/definitions/semver"
        },
        "licence_check": {
            "type": "string",
            "enum": ["PASS", "FAIL"]
        },
        "playwright_version": {
            "$ref": "common.schema.json#/definitions/semver"
        },
        "browser_build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "revision"],
            "properties": {
                "name": {
                    "type": "string",
                    "enum": ["chromium_headless_shell", "chromium"]
                },
                "revision": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "release"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "ref": {
                        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "main"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "ref": {
                        "enum": ["master", "main"]
                    }
                }
            }
        }
    ]
}

{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "es2022",
        "lib": ["esnext", "dom"],
        "types": ["node"],
        "typeRoots": ["../node_modules/@types"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["./**/*.ts", "../playwright.config.ts", "../generated/*.spec.ts", "../sessions/*/generated/*.spec.ts"]
}

exports[`components/user_settings/notifications/EmailNotificationSetting should match snapshot, enabled email batching 1`] = `
<div>
  <section
    class="section-max form-horizontal "
  >
    <h4
      class="col-sm-12 section-title"
      id="settingTitle"
    >
      Email notifications
    </h4>
    <div
      class="sectionContent col-sm-10 col-sm-offset-2"
    >
      <div
        class="setting-list"
        tabindex="-1"
      >
        <div
          class="setting-list-item"
        >
          <fieldset>
            <legend
              class="form-legend"
            >
              Send email notifications
            </legend>
            <fieldset>
              <div
                class="settings-radio-group"
              >
                <label
                  class="_radio_1v3hu_13 _radio--size-medium_1v3hu_154"
                  for="emailNotificationImmediately"
                >
                  <input
                    class="_radio__input_1v3hu_28"
                    data-email-interval="30"
                    data-enable-email="true"
                    id="emailNotificationImmediately"
                    name="emailNotifications"
                    type="radio"
                  />
                  <span
                    class="_radio__circle_1v3hu_47"
                  >
                    <span
                      aria-hidden="true"
                      class="_radio__dot_1v3hu_73"
                    />
                  </span>
                  <span
                    class="_radio__label_1v3hu_130"
                  >
                    As soon as you’re away for 5 minutes
                  </span>
                </label>
                <label
                  class="_radio_1v3hu_13 _radio--size-medium_1v3hu_154"
                  for="emailNotificationMinutes"
                >
                  <input
                    class="_radio__input_1v3hu_28"
                    data-email-interval="900"
                    data-enable-email="true"
                    id="emailNotificationMinutes"
                    name="emailNotifications"
                    type="radio"
                  />
                  <span
                    class="_radio__circle_1v3hu_47"
                  >
                    <span
                      aria-hidden="true"
                      class="_radio__dot_1v3hu_73"
                    />
                  </span>
                  <span
                    class="_radio__label_1v3hu_130"
                  >
                    Every 15 minutes
                  </span>
                </label>
                <label
                  class="_radio_1v3hu_13 _radio--size-medium_1v3hu_154"
                  for="emailNotificationHour"
                >
                  <input
                    class="_radio__input_1v3hu_28"
                    data-email-interval="3600"
                    data-enable-email="true"
                    id="emailNotificationHour"
                    name="emailNotifications"
                    type="radio"
                  />
                  <span
                    class="_radio__circle_1v3hu_47"
                  >
                    <span
                      aria-hidden="true"
                      class="_radio__dot_1v3hu_73"
                    />
                  </span>
                  <span
                    class="_radio__label_1v3hu_130"
                  >
                    Every hour
                  </span>
                </label>
                <label
                  class="_radio_1v3hu_13 _radio--size-medium_1v3hu_154"
                  for="emailNotificationNever"
                >
                  <input
                    checked=""
                    class="_radio__input_1v3hu_28 a11y--active a11y--focused"
                    data-email-interval="0"
                    data-enable-email="false"
                    id="emailNotificationNever"
                    name="emailNotifications"
                    type="radio"
                  />
                  <span
                    class="_radio__circle_1v3hu_47"
                  >
                    <span
                      aria-hidden="true"
                      class="_radio__dot_1v3hu_73"
                    />
                  </span>
                  <span
                    class="_radio__label_1v3hu_130"
                  >
                    Never
                  </span>
                </label>
              </div>
            </fieldset>
            <div
              class="mt-3"
            >
              Email notifications are sent for mentions and direct messages when you are offline or away for more than 5 minutes. If you choose to receive notifications every 15 minutes or every hour, notifications during that period will be combined into a single email.
            </div>
          </fieldset>
        </div>
        <div
          class="setting-list-item"
        >
          <hr />
          <div
            role="alert"
          />
          <div
            class="setting-list-item__buttons"
          >
            <button
              class="_button_1pij1_13 _button--emphasis-primary_1pij1_111 _button--size-medium_1pij1_88"
              data-testid="saveSetting"
              id="saveSetting"
              type="submit"
            >
              <span
                class="_button__label_1pij1_55"
              >
                Save
              </span>
            </button>
            <button
              class="_button_1pij1_13 _button--emphasis-tertiary_1pij1_141 _button--size-medium_1pij1_88"
              data-testid="cancelButton"
              id="cancelSetting"
              type="button"
            >
              <span
                class="_button__label_1pij1_55"
              >
                Cancel
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
`;


                class="_admin-panel-header__title_19tix_37"
                id="_r_5_"
              >
                Team Profile
              </h2>
            </div>
            <p
              class="_admin-panel-header__subtitle_19tix_66"
            >
              Summary of the team, including team name and description.
            </p>
          </div>
        </div>
      </div>
    </header>
    <div
      class="_admin-panel__body_iwm08_25"
    >
      <div
        class="d-flex"
      >

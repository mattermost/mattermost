// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`admin_console/team_channel_settings/team/TeamProfile should match snapshot (not cloud, freemium disabled 1`] = `
<div>
  <div
    class="AdminPanel clearfix "
    id="team_profile"
  >
    <div
      class="header"
    >
      <div>
        <h3>
          Team Profile
        </h3>
        <div
          class="mt-2"
        >
          Summary of the team, including team name and description.
        </div>
      </div>
    </div>
    <div
      class="group-teams-and-channels"
    >
      <div
        class="group-teams-and-channels--body"
      >
        <div
          class="d-flex"
        >
          <div
            class="large-team-image-col"
          >
            <div
              class="TeamIcon TeamIcon__lg no-hover"
            >
              <div
                class="TeamIcon__content no-hover"
              >
                <div
                  aria-label="name Team Initials"
                  class="TeamIcon__initials TeamIcon__initials__lg"
                  data-testid="teamIconInitial"
                  role="img"
                >
                  na
                </div>
              </div>
            </div>
          </div>
          <div
            class="team-desc-col team-desc-col--edit"
          >
            <div
              class="row row-bottom-padding"
            >
              <div
                class="Input_container"
              >
                <div
                  class="_text-input_3inqk_2 _text-input--size-medium_3inqk_162 _text-input--label-floated_3inqk_73 Input"
                >
                  <div
                    class="_text-input__wrapper_3inqk_31"
                  >
                    <label
                      class="_text-input__label_3inqk_53"
                      for="teamName"
                    >
                      Team Name
                    </label>
                    <div
                      class="_text-input__inner_3inqk_80"
                    >
                      <input
                        class="_text-input__input_3inqk_42"
                        data-testid="teamNameInput"
                        id="teamName"
                        maxlength="64"
                        type="text"
                        value="name"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="row"
            >
              <div
                class="Input_container"
              >
                <div
                  class="_text-area_r07x5_2 _text-area--size-medium_r07x5_109 Input"
                >
                  <div
                    class="_text-area__wrapper_r07x5_8"
                  >
                    <label
                      class="_text-area__label_r07x5_25"
                      for="teamDescription"
                    >
                      Team Description
                    </label>
                    <textarea
                      class="_text-area__input_r07x5_15"
                      data-testid="teamDescriptionInput"
                      id="teamDescription"
                      maxlength="50"
                      rows="3"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="AdminChannelDetails_archiveContainer"
        >
          <button
            class="btn btn-secondary btn-danger"
            type="button"
          >
            <i
              class="icon icon-archive-outline"
            />
            Archive Team
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;


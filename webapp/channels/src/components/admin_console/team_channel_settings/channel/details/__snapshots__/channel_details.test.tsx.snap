                class="AdminChannelDetails_archiveContainer"
              >
                <button
                  class="_button_doayp_2 _button--emphasis-secondary_doayp_75 _button--size-medium_doayp_47 _button--destructive_doayp_130"
                  type="button"
                >
                  <span
                    aria-hidden="true"
                    class="_button__icon-slot_doayp_27"
                  >
                    <div
                      aria-hidden="true"
                      class="_icon_1i355_2 _icon--size-16_1i355_38"
                    >
                      <div
                        class="_icon__glyph-area_1i355_9"
                      >
                        <svg
                          fill="currentColor"
                          height="18"
                          version="1.1"
                          viewBox="0 0 24 24"
                          width="18"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M20 21H4V10H6V19H18V10H20V21M3 3H21V9H3V3M9.5 11H14.5C14.78 11 15 11.22 15 11.5V13H9V11.5C9 11.22 9.22 11 9.5 11M5 5V7H19V5H5Z"
                          />
                        </svg>
                      </div>
                    </div>
                  </span>
                  <span
                    class="_button__label_doayp_24"
                  >
                    Archive Channel
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_moderation"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Advanced Access Control
              </h3>
              <div
                class="mt-2"
              >
                Manage the actions available to channel members and guests.
              </div>
            </div>
          </div>
          <div
            class="channel-moderation"
          >
            <div
              class="channel-moderation--body"
            >
              <table
                class="channel-moderation--table"
                id="channel_moderation_table"
              >
                <thead>
                  <tr>
                    <th>
                      Permissions
                    </th>
                    <th>
                      Guests
                    </th>
                    <th>
                      Members
                    </th>
                  </tr>
                </thead>
                <tbody />
              </table>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_manage"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Channel Management
              </h3>
              <div
                class="mt-2"
              >
                Choose between inviting members manually or syncing members automatically from groups.
              </div>
            </div>
          </div>
          <div
            class="group-teams-and-channels"
          >
            <div
              class="group-teams-and-channels--body"
            >
              <div>

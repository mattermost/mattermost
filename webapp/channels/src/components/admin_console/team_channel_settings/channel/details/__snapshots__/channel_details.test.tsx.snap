              id="groups-list--body"
            >
              <div
                class="groups-list-loading"
              >
                <i
                  class="fa fa-spinner fa-pulse fa-2x"
                />
              </div>
            </div>
            <div
              class="groups-list--footer"
            >
              <div
                class="counter"
              >
                1 - 1 of 1
              </div>
              <button
                class="_button_doayp_2 _button--emphasis-tertiary_doayp_91 _button--size-medium_doayp_47 disabled"

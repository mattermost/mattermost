exports[`admin_console/team_channel_settings/channel/ChannelDetails should match snapshot for Enterprise 2`] = `
<div>
  <div
    class="wrapper--fixed"
  >
    <div
      class="admin-console__header with-back"
      data-testid="admin-console-header"
    >
      <div>
        <a
          class="fa fa-angle-left back"
          href="/admin_console/user_management/channels"
        />
        Channel Configuration
      </div>
    </div>
    <div
      class="admin-console__wrapper"
    >
      <div
        class="admin-console__content"
      >
        <div
          class="AdminPanel clearfix "
          id="channel_profile"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Channel Profile
              </h3>
              <div
                class="mt-2"
              >
                Summary of the channel, including the channel name.
              </div>
            </div>
          </div>
          <div
            class="group-teams-and-channels AdminChannelDetails"
          >
            <div
              class="group-teams-and-channels--body channel-desc-col"
            >
              <div
                class="channel-name"
              >
                <b>
                  Name
                </b>
                <br />
                name
              </div>
              <div
                class="channel-team"
              >
                <b>
                  Team
                </b>
                <br />
              </div>
              <div
                class="AdminChannelDetails_archiveContainer"
              >
                <button
                  class="btn btn-secondary btn-danger"
                  type="button"
                >
                  <i
                    class="icon icon-archive-outline"
                  />
                  Archive Channel
                </button>
              </div>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_moderation"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Advanced Access Control
              </h3>
              <div
                class="mt-2"
              >
                Manage the actions available to channel members and guests.
              </div>
            </div>
          </div>
          <div
            class="channel-moderation"
          >
            <div
              class="channel-moderation--body"
            >
              <table
                class="channel-moderation--table"
                id="channel_moderation_table"
              >
                <thead>
                  <tr>
                    <th>
                      Permissions
                    </th>
                    <th>
                      Guests
                    </th>
                    <th>
                      Members
                    </th>
                  </tr>
                </thead>
                <tbody />
              </table>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_manage"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Channel Management
              </h3>
              <div
                class="mt-2"
              >
                Choose between inviting members manually or syncing members automatically from groups.
              </div>
            </div>
          </div>
          <div
            class="group-teams-and-channels"
          >
            <div
              class="group-teams-and-channels--body"
            >
              <div
                class="AdminSettingsSegmentedRow"
                data-testid="allow-all-toggle"
              >
                <div
                  class="AdminSettingsSegmentedRow__text"
                >
                  <div
                    class="AdminSettingsSegmentedRow__title"
                  >
                    Public channel or private channel
                  </div>
                  <div
                    class="AdminSettingsSegmentedRow__description"
                  >
                    Select Public for a channel any user can find and join. 
                    <br />
                    Select Private to require channel invitations to join. 
                    <br />
                    Use this control to change this channel from public to private or from private to public.
                  </div>
                </div>
                <div
                  aria-label="Public channel or private channel"
                  class="AdminSettingsSegmentedRow__segments"
                  role="group"
                >
                  <button
                    aria-pressed="true"
                    class="AdminSettingsSegmentedRow__segment AdminSettingsSegmentedRow__segment--active"
                    data-testid="allow-all-toggle-public"
                    id="allow-all-toggle-public"
                    type="button"
                  >
                    Public
                  </button>
                  <button
                    aria-pressed="false"
                    class="AdminSettingsSegmentedRow__segment"
                    data-testid="allow-all-toggle-private"
                    id="allow-all-toggle-private"
                    type="button"
                  >
                    Private
                  </button>
                </div>
              </div>
              <div
                class="section-separator"
              >
                <hr
                  class="separator__hr"
                />
              </div>
              <div
                data-testid="policy-enforce-toggle"
              >
                <label
                  class="switch switch--size-medium switch--semi-bold switch--with-secondary"
                  for="policy-enforce-toggle"
                >
                  <span
                    class="switch__labels"
                  >
                    <span
                      class="switch__label"
                    >
                      Enable attribute based channel access
                    </span>
                    <span
                      class="switch__secondary-label"
                    >
                      Recommend this channel to users whose attributes match the rules and (optionally) auto-add them. Anyone can still join freely.
                    </span>
                  </span>
                  <span
                    class="switch__track"
                  >
                    <input
                      aria-checked="false"
                      class="switch__input"
                      data-testid="policy-enforce-toggle-button"
                      id="policy-enforce-toggle"
                      role="switch"
                      tabindex="0"
                      type="checkbox"
                    />
                    <span
                      aria-hidden="true"
                      class="switch__knob"
                    />
                  </span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div>
          ChannelMembers
        </div>
      </div>
    </div>
    <div
      class="admin-console-save"
    >
      <button
        class="btn btn-primary"
        data-testid="saveSetting"
        disabled=""
        id="saveSetting"
        type="submit"
      >
        <span>
          Save
        </span>
      </button>
      <a
        class="btn btn-quaternary"
        href="/admin_console/user_management/channels"
        id="cancelButtonSettings"
      >
        Cancel
      </a>
      <div
        class="error-message"
        data-testid="saveChangesPanel-errorMessage"
      />
    </div>
  </div>
</div>
`;


// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`admin_console/team_channel_settings/channel/ChannelDetails should match snapshot 1`] = `
<div>
  <div
    class="wrapper--fixed"
  >
    <div
      class="admin-console__header with-back"
      data-testid="admin-console-header"
    >
      <div>
        <a
          class="fa fa-angle-left back"
          href="/admin_console/user_management/channels"
        />
        Channel Configuration
      </div>
    </div>
    <div
      class="admin-console__wrapper"
    >
      <div
        class="admin-console__content"
      >
        <div
          class="AdminPanel clearfix "
          id="channel_profile"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Channel Profile
              </h3>
              <div
                class="mt-2"
              >
                Summary of the channel, including the channel name.
              </div>
            </div>
          </div>
          <div
            class="group-teams-and-channels AdminChannelDetails"
          >
            <div
              class="group-teams-and-channels--body channel-desc-col"
            >
              <div
                class="channel-name"
              >
                <b>
                  Name
                </b>
                <br />
                name
              </div>
              <div
                class="channel-team"
              >
                <b>
                  Team
                </b>
                <br />
                test
              </div>
              <div
                class="AdminChannelDetails_archiveContainer"
              >
                <button
                  class="btn btn-secondary btn-danger"
                  type="button"
                >
                  <i
                    class="icon icon-archive-outline"
                  />
                  Archive Channel
                </button>
              </div>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_moderation"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Advanced Access Control
              </h3>
              <div
                class="mt-2"
              >
                Manage the actions available to channel members and guests.
              </div>
            </div>
          </div>
          <div
            class="channel-moderation"
          >
            <div
              class="channel-moderation--body"
            >
              <table
                class="channel-moderation--table"
                id="channel_moderation_table"
              >
                <thead>
                  <tr>
                    <th>
                      Permissions
                    </th>
                    <th>
                      Guests
                    </th>
                    <th>
                      Members
                    </th>
                  </tr>
                </thead>
                <tbody />
              </table>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_manage"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Channel Management
              </h3>
              <div
                class="mt-2"
              >
                Choose between inviting members manually or syncing members automatically from groups.
              </div>
            </div>
          </div>
          <div
            class="group-teams-and-channels"
          >
            <div
              class="group-teams-and-channels--body"
            >
              <div
                data-testid="syncGroupSwitch"
              >
                <label
                  class="switch switch--size-medium switch--semi-bold switch--with-secondary"
                  for="syncGroupSwitch"
                >
                  <span
                    class="switch__labels"
                  >
                    <span
                      class="switch__label"
                    >
                      Sync Group Members
                    </span>
                    <span
                      class="switch__secondary-label"
                    >
                      When enabled, adding and removing users from groups will add or remove them from this channel. The only way of inviting members to this channel is by adding the groups they belong to. 
                      <a
                        href="https://mattermost.com/pl/default-ldap-group-constrained-team-channel.html?utm_source=mattermost&utm_medium=in-product&utm_content=channel_modes&uid=&sid=&edition=team&server_version="
                        location="channel_modes"
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        Learn More
                      </a>
                    </span>
                  </span>
                  <span
                    class="switch__track"
                  >
                    <input
                      aria-checked="false"
                      class="switch__input"
                      data-testid="syncGroupSwitch-button"
                      id="syncGroupSwitch"
                      role="switch"
                      tabindex="0"
                      type="checkbox"
                    />
                    <span
                      aria-hidden="true"
                      class="switch__knob"
                    />
                  </span>
                </label>
              </div>
              <div
                class="section-separator"
              >
                <hr
                  class="separator__hr"
                />
              </div>
              <div
                class="AdminSettingsSegmentedRow"
                data-testid="allow-all-toggle"
              >
                <div
                  class="AdminSettingsSegmentedRow__text"
                >
                  <div
                    class="AdminSettingsSegmentedRow__title"
                  >
                    Public channel or private channel
                  </div>
                  <div
                    class="AdminSettingsSegmentedRow__description"
                  >
                    Select Public for a channel any user can find and join. 
                    <br />
                    Select Private to require channel invitations to join. 
                    <br />
                    Use this control to change this channel from public to private or from private to public.
                  </div>
                </div>
                <div
                  aria-label="Public channel or private channel"
                  class="AdminSettingsSegmentedRow__segments"
                  role="group"
                >
                  <button
                    aria-pressed="true"
                    class="AdminSettingsSegmentedRow__segment AdminSettingsSegmentedRow__segment--active"
                    data-testid="allow-all-toggle-public"
                    id="allow-all-toggle-public"
                    type="button"
                  >
                    Public
                  </button>
                  <button
                    aria-pressed="false"
                    class="AdminSettingsSegmentedRow__segment"
                    data-testid="allow-all-toggle-private"
                    id="allow-all-toggle-private"
                    type="button"
                  >
                    Private
                  </button>
                </div>
              </div>
              <div
                class="section-separator"
              >
                <hr
                  class="separator__hr"
                />
              </div>
              <div
                data-testid="policy-enforce-toggle"
              >
                <label
                  class="switch switch--size-medium switch--semi-bold switch--with-secondary"
                  for="policy-enforce-toggle"
                >
                  <span
                    class="switch__labels"
                  >
                    <span
                      class="switch__label"
                    >
                      Enable attribute based channel access
                    </span>
                    <span
                      class="switch__secondary-label"
                    >
                      Recommend this channel to users whose attributes match the rules and (optionally) auto-add them. Anyone can still join freely.
                    </span>
                  </span>
                  <span
                    class="switch__track"
                  >
                    <input
                      aria-checked="false"
                      class="switch__input"
                      data-testid="policy-enforce-toggle-button"
                      id="policy-enforce-toggle"
                      role="switch"
                      tabindex="0"
                      type="checkbox"
                    />
                    <span
                      aria-hidden="true"
                      class="switch__knob"
                    />
                  </span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div
          class="AdminPanel clearfix "
          id="channel_groups"
        >
          <div
            class="header"
          >
            <div>
              <h3>
                Groups
              </h3>
              <div
                class="mt-2"
              >
                Select groups to be added to this channel.
              </div>
            </div>
            <div
              class="button"
            >
              <button
                class="style--none btn btn-primary"
                id="addGroupsToChannelToggle"
              >
                Add Group
              </button>
            </div>
          </div>
          <div
            class="groups-list groups-list-no-padding"
          >
            <div
              class="groups-list--header"
            >
              <div
                class="group-name group-name-adjusted"
              >
                Group Name
              </div>
              <div
                class="group-content"
              >
                <div
                  class="group-description group-description-adjusted"
                >
                  Member Count
                </div>
                <div
                  class="group-description group-description-adjusted"
                >
                  Roles
                </div>
                <div
                  class="group-actions"
                />
              </div>
            </div>
            <div
              class="groups-list--body"
              id="groups-list--body"
            >
              <div
                class="groups-list-loading"
              >
                <i
                  class="fa fa-spinner fa-pulse fa-2x"
                />
              </div>
            </div>
            <div
              class="groups-list--footer"
            >
              <div
                class="counter"
              >
                1 - 1 of 1
              </div>
              <button
                class="btn btn-tertiary disabled"
                disabled=""
                type="button"
              >
                <i
                  class="icon icon-chevron-left"
                  title="Previous Icon"
                />
              </button>
              <button
                class="btn btn-tertiary disabled"
                data-testid="page-link-next"
                disabled=""
                type="button"
              >
                <i
                  class="icon icon-chevron-right"
                  title="Next Icon"
                />
              </button>
            </div>
          </div>
        </div>
        <div>
          ChannelMembers
        </div>
      </div>
    </div>
    <div
      class="admin-console-save"
    >
      <button
        class="btn btn-primary"
        data-testid="saveSetting"
        disabled=""
        id="saveSetting"
        type="submit"
      >
        <span>
          Save
        </span>
      </button>
      <a
        class="btn btn-quaternary"
        href="/admin_console/user_management/channels"
        id="cancelButtonSettings"
      >
        Cancel
      </a>
      <div
        class="error-message"
        data-testid="saveChangesPanel-errorMessage"
      />
    </div>
  </div>
</div>
`;


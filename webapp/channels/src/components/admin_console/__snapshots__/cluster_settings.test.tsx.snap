              </div>
            </div>
          </div>
          <fieldset
            class="form-group"
            data-testid="UseIPAddress"
            id="UseIPAddress"
          >
            <legend
              class="control-label form-legend col-sm-4"
            >
              Use IP Address:
            </legend>
            <div
              class="col-sm-8"
            >
              <div
                class="BooleanRadioGroup-gkBvtd joVEQU"

<div>
  <form
    class="form-horizontal"
    role="form"
  >
    <div
      class="wrapper--fixed"
    >
      <div
        class="admin-console__header"
        data-testid="admin-console-header"
      >
        High Availability
      </div>
      <div
        class="admin-console__wrapper"
      >
        <div
          class="admin-console__content"
        >
          <div
            class="loading-screen"
            data-testid="loading-screen"
            style="position: relative;"
          >
            <div
              class="loading__content"
            >
              <p>
                Loading
              </p>
              <div
                class="round round-1"
              />
              <div
                class="round round-2"
              />
              <div
                class="round round-3"
              />
            </div>
          </div>
          <div
            class="banner"
          >
            Changing properties in this section will require a server restart before taking effect.
          </div>
          <fieldset
            class="form-group"
            data-testid="Enable"
            id="Enable"
          >
            <legend
              class="control-label form-legend col-sm-4"
            >
              Enable High Availability Mode:
            </legend>
            <div
              class="col-sm-8"
            >
              <div
                class="BooleanRadioGroup-gkBvtd joVEQU"
              >
                <label
                  class="_radio_h0rbb_2 _radio--size-medium_h0rbb_143"
                  for="Enabletrue"
                >
                  <input
                    checked=""
                    class="_radio__input_h0rbb_17"
                    data-testid="Enabletrue"
                    id="Enabletrue"
                    name="Enable"
                    type="radio"
                    value="true"
                  />
                  <span
                    class="_radio__circle_h0rbb_36"
                  >
                    <span
                      aria-hidden="true"
                      class="_radio__dot_h0rbb_62"
                    />
                  </span>
                  <span
                    class="_radio__label_h0rbb_119"
                  >

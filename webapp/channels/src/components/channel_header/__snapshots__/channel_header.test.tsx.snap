exports[`components/ChannelHeader should match snapshot with last active display 1`] = `
<div>
  <div
    aria-label="channel header region"
    class="channel-header alt a11y__region"
    data-a11y-sort-order="8"
    data-channelid="channel_id"
    id="channel-header"
    role="banner"
    tabindex="-1"
  >
    <div
      class="flex-parent"
    >
      <div
        class="flex-child"
      >
        <div
          class="channel-header__info"
          id="channelHeaderInfo"
        >
          <div
            class="channel-header__title dropdown"
          >
            <div
              class="channel-header__icons"
            >
              <button
                aria-label="Channel files"
                class="_icon-button_g2m23_2 _icon-button--size-x-small_g2m23_55 channel-header__icon"
                id="channelHeaderFilesButton"
                type="button"
              >
                <span
                  aria-hidden="true"
                  class="_icon-button__icon-slot_g2m23_33"
                >
                  <i
                    class="icon icon-file-text-outline"
                  />
                </span>
              </button>
            </div>
            <div
              class="channel-header__description"
              id="channelHeaderDescription"
            >
              <span
                class="header-status__text"
              >
                <span
                  class="last-active__text"
                >
                  Last online 
                  <time
                    datetime="2021-09-20T16:02:42.846"
                  >
                    September 20, 2021
                  </time>
                </span>
              </span>
              <div
                class="header-description__text"
              >
                <p
                  class="markdown__paragraph-inline"
                >
                  not the bot description
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button
        aria-label="Open in new window"
        class="_icon-button_g2m23_2 _icon-button--size-small_g2m23_69 PopoutButton channel-header__icon channel-header__icon--small"
        type="button"
      >
        <span
          aria-hidden="true"
          class="_icon-button__icon-slot_g2m23_33"
        >
          <i
            aria-hidden="true"
            class="icon icon-dock-window"
          />
        </span>
      </button>
      <button
        aria-label="View Info"
        class="_icon-button_g2m23_2 _icon-button--size-small_g2m23_69 channel-header__icon channel-header__icon--small"
        id="channel-info-btn"
        type="button"
      >
        <span
          aria-hidden="true"
          class="_icon-button__icon-slot_g2m23_33"
        >
          <i
            class="Icon-clPswv hCFmLO icon-information-outline"
          />
        </span>
      </button>
    </div>
  </div>
</div>
`;

